# Copier en .env.local pour le développement. Ne jamais committer de valeur réelle.
# Sur Vercel : Settings → Environment Variables, valeurs distinctes pour Preview et Production.

# --- Exposées au navigateur (préfixe VITE_) -----------------------------------
# DSN public Sentry. Vide = aucun suivi d'erreurs chargé.
VITE_SENTRY_DSN=

# Fournies automatiquement par Vercel au build (ne pas définir à la main) :
# VITE_VERCEL_ENV=production|preview|development   → active Analytics / Speed Insights
# VITE_VERCEL_GIT_COMMIT_SHA=…                      → version (« release ») Sentry

# --- Build uniquement (jamais exposées au navigateur) ---------------------------
# Envoi des source maps à Sentry puis suppression du build. Vides = pas de source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Comptes et synchronisation (lot L2, voir docs/supabase.md). Vides = mode local pur.
VITE_SUPABASE_URL=
# Clé PUBLIQUE uniquement (publishable / anon). Jamais la clé service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=
